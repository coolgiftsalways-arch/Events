PORT=5000
# MongoDB Atlas -> Connect -> Drivers. Put your DB name (events) after .mongodb.net/
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/events?retryWrites=true&w=majority
FORCE_PUBLIC_DNS=true
CLIENT_URL=http://localhost:5173
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=any-random-string-you-also-type-in-razorpay
# Razorpay Dashboard -> Subscriptions -> Plans (ids start with plan_)
RAZORPAY_PLAN_SILVER=plan_xxx
RAZORPAY_PLAN_GOLD=plan_xxx
RAZORPAY_PLAN_VENDOR_BASIC=plan_xxx
RAZORPAY_PLAN_VENDOR_GROWTH=plan_xxx
RAZORPAY_PLAN_VENDOR_PREMIUM=plan_xxx
